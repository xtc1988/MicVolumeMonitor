<Window x:Class="MicVolumeMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MicVolumeMonitor"
        mc:Ignorable="d"
        Title="マイク音量モニター" Height="850" Width="480"
        Background="#F9FAFB"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">

    <Window.Resources>
        <DropShadowEffect x:Key="CardShadow"
                          ShadowDepth="0"
                          BlurRadius="20"
                          Opacity="0.15"
                          Color="#000000"/>
    </Window.Resources>

    <Grid Background="#F9FAFB">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White"
                CornerRadius="12"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                Effect="{StaticResource CardShadow}">

            <StackPanel>
                <Border BorderBrush="#F3F4F6"
                        BorderThickness="0,0,0,1">
                    <StackPanel Margin="24,20">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border x:Name="IconBox"
                                    Width="28" Height="28"
                                    Background="#DBEAFE"
                                    CornerRadius="6"
                                    Margin="0,0,8,0">
                                <TextBlock Text="🎤"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="マイク音量モニター"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="#111827"/>
                        </StackPanel>

                        <TextBlock Text="音量を監視して上限を超えたら警告します"
                                   FontSize="13"
                                   Foreground="#6B7280"/>
                    </StackPanel>
                </Border>

                <StackPanel Margin="24,24,24,28">

                    <Border Background="#F9FAFB"
                            BorderBrush="#F3F4F6"
                            BorderThickness="2"
                            CornerRadius="12"
                            Margin="0,0,0,24">
                        <StackPanel Margin="0,32">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,8">
                                <TextBlock x:Name="ActivityIcon"
                                           Text="●"
                                           FontSize="14"
                                           Foreground="#9CA3AF"
                                           Margin="0,0,12,0"/>
                                <TextBlock Text="現在の音量"
                                           FontSize="13"
                                           Foreground="#6B7280"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,0,0,8">
                                <TextBlock x:Name="CurrentLevelText"
                                           Text="--"
                                           FontSize="72"
                                           FontWeight="Bold"
                                           Foreground="#111827"/>
                                <TextBlock Text="dB"
                                           FontSize="32"
                                           Foreground="#9CA3AF"
                                           VerticalAlignment="Bottom"
                                           Margin="4,0,0,12"/>
                            </StackPanel>

                            <TextBlock x:Name="InfoText"
                                       Text="監視音量: 80dB / ピーク: --dB"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,24" Height="12">
                        <Border Background="#E5E7EB"
                                CornerRadius="6"/>

                        <Border x:Name="MeterBar"
                                Background="#3B82F6"
                                CornerRadius="6"
                                HorizontalAlignment="Left"
                                Width="0"/>
                    </Grid>

                    <Grid Margin="0,0,0,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="監視音量"
                                       FontSize="13"
                                       Foreground="#111827"
                                       HorizontalAlignment="Left"/>
                            <Border Background="#F3F4F6"
                                    CornerRadius="4"
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Margin="8,4">
                                    <TextBlock x:Name="ThresholdValueText" Text="80"/>
                                    <TextBlock Text="dB"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Slider x:Name="ThresholdSlider"
                                Grid.Row="1"
                                Minimum="30"
                                Maximum="120"
                                Value="80"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                ValueChanged="ThresholdSlider_ValueChanged"/>

                        <TextBlock x:Name="ThresholdDescriptionText"
                                   Grid.Row="2"
                                   Text="掃除機・騒がしい事務所"
                                   FontSize="12"
                                   Foreground="#6B7280"
                                   TextAlignment="Center"
                                   Margin="0,8,0,0"/>
                    </Grid>

                    <Grid Margin="0,0,0,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="警告音量"
                                       FontSize="13"
                                       Foreground="#111827"
                                       HorizontalAlignment="Left"/>
                            <Border Background="#F3F4F6"
                                    CornerRadius="4"
                                    HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Margin="8,4">
                                    <TextBlock x:Name="WarningVolumeValueText" Text="80"/>
                                    <TextBlock Text="%"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Slider x:Name="WarningVolumeSlider"
                                Grid.Row="1"
                                Minimum="10"
                                Maximum="100"
                                Value="80"
                                TickFrequency="10"
                                IsSnapToTickEnabled="True"
                                ValueChanged="WarningVolumeSlider_ValueChanged"/>
                    </Grid>

                    <Grid Margin="0,0,0,24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="マイク選択"
                                   FontSize="13"
                                   Foreground="#111827"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="MicrophoneComboBox"
                                  Grid.Row="1"
                                  Height="36"
                                  SelectionChanged="MicrophoneComboBox_SelectionChanged"/>
                    </Grid>

                    <Border x:Name="WarningAlert"
                            Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,0,16"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="12">
                            <TextBlock Text="⚠"
                                       FontSize="16"
                                       Foreground="#DC2626"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="音量が監視音量を超えています"
                                       FontSize="13"
                                       Foreground="#991B1B"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="StartButton"
                                Grid.Column="0"
                                Content="開始"
                                Height="40"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Click="StartButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#2563EB"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        BorderThickness="0">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#1E3A8A"/>
                                                        <Setter TargetName="border" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="border" Property="Background" Value="#D1D5DB"/>
                                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button x:Name="StopButton"
                                Grid.Column="2"
                                Content="停止"
                                Height="40"
                                FontSize="14"
                                FontWeight="SemiBold"
                                IsEnabled="False"
                                Click="StopButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#374151"/>
                                    <Setter Property="BorderBrush" Value="#D1D5DB"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="border"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#E5E7EB"/>
                                                        <Setter TargetName="border" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="border" Property="Background" Value="#F9FAFB"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="border" Property="Background" Value="#F3F4F6"/>
                                                        <Setter Property="Foreground" Value="#9CA3AF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <CheckBox x:Name="AutoStartCheckBox"
                              Content="PC起動時に自動起動"
                              FontSize="12"
                              Foreground="#6B7280"
                              HorizontalAlignment="Center"
                              Margin="0,16,0,0"
                              Checked="AutoStartCheckBox_Changed"
                              Unchecked="AutoStartCheckBox_Changed"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
